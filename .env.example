# ============================================
# LLM Provider 切换 / Provider selection
# 可选 / options: openai | deepseek | ollama
# ============================================
LLM_PROVIDER=ollama

# ---------- OpenAI ----------
OPENAI_API_KEY=         # 用 DeepSeek 时请清空或注释掉本行，避免占位符 sk-xxx 被误用
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---------- DeepSeek (OpenAI 兼容 / OpenAI-compatible) ----------
DEEPSEEK_API_KEY=请替换为真实key   # ← 改成真实 key；保留 sk-xxx 占位符会报 401
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 若使用 DeepSeek：将上方 LLM_PROVIDER 设为 deepseek，并清空上面的 OPENAI_API_KEY

# ---------- Ollama (本地 / local, 免 key / key-free) ----------
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# 使用前请先 `ollama pull qwen2.5:7b` 与 `ollama pull nomic-embed-text`

# ---------- Embedding 模型（RAG 用） ----------
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---------- 可观测性（Phase 8，项目决策：Langfuse 为主） ----------
# 在 https://cloud.langfuse.com 注册后获取，或自托管
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- 可观测性（可选：LangSmith 官方 SaaS） ----------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_xxx
# LANGCHAIN_PROJECT=langgraph-course
